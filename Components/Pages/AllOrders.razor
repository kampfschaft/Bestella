@page "/allorders"
@rendermode InteractiveServer

@using System.Globalization
@using Microsoft.EntityFrameworkCore;
@using Bestella.Models;
@using Bestella.Data;
@inject OrderDbContext Db


<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-primary">All Orders</h3>
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="sortSwitch" @bind="sortDescending">
        <label class="form-check-label" for="sortSwitch">Most Recent First</label>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (orders == null)
{
    <p><em>Loading...</em></p>
}
else if (!orders.Any())
{
    <div class="alert alert-info shadow-sm"> No Orders found.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Date</th>
                <th>Address</th>
                <th>Items</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in orders)
            {
                <tr @onclick="() => OpenModal(order)" style="cursor: pointer;">
                    <td>@order.Name</td>
                    <td>@order.Phone</td>
                    <td>@(order.ParsedDate?.ToString("dd MMMM yyyy") ?? order.Date)</td>
                    <td>@order.Address</td>
                    <td>
                        <ul>
                            @foreach (var item in order.Items)
                            {
                                <li>@item.Quantity x @item.ProductName</li>
                            }
                        </ul>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (selectedOrder is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Order</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Name</label>
                        <input class="form-control" @bind="selectedOrder.Name" />
                    </div>
                    <div class="mb-3">
                        <label>Phone</label>
                        <input class="form-control" @bind="selectedOrder.Phone" />
                    </div>
                    <div class="mb-3">
                        <label for="orderDate" class="form-label">Date</label>
                        <input type="date"
                            id="orderDate"
                            class="form-control"
                            value="@BindDate"
                            @onchange="OnDateChanged" ss/>
                    </div>
                    <div class="mb-3">
                        <label>Address</label>
                        <input class="form-control" @bind="selectedOrder.Address" />
                    </div>
                    <div class="mb-3">
                        <label>Items</label>
                        @foreach (var item in selectedOrder.Items)
                        {
                            <div class="d-flex mb-2">
                                <input class="form-control me-2" placeholder=@($"Product={item.ProductName}") @bind="item.ProductName" />
                                <input class="form-control" type="number"
                                    min="1"
                                    max="1000"
                                    placeholder=@($"Quantity={item.Quantity}")
                                    value="@item.Quantity"
                                    @oninput="@((e) => OnQuantityInput(e, item))" />
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger me-auto" @onclick="DeleteOrder">Delete</button>
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveChanges">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showSaveConfirmation)
{
    <div class="confirmation-overlay" @onclick="CancelSaveChanges">
        <div class="confirmation-dialog" role="dialog" aria-modal="true" aria-labelledby="confirmation-title" @onclick:stopPropagation>
            <div class="confirmation-header">
                <div class="confirmation-icon">
                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                </div>
                <div>
                    <h5 id="confirmation-title" class="mb-1">Confirmation</h5>
                    <p class="mb-0 text-muted">Review your changes before saving.</p>
                </div>
                <button type="button" class="btn-close ms-auto" @onclick="CancelSaveChanges" aria-label="Close"></button>
            </div>
            <div class="confirmation-body">
                <p class="mb-0">Save changes to this order?</p>
            </div>
            <div class="confirmation-footer">
                <button class="btn btn-light" @onclick="CancelSaveChanges">Cancel</button>
                <button class="btn btn-primary" @onclick="ConfirmSaveChanges">
                    <i class="bi bi-check2 me-1" aria-hidden="true"></i>Save changes
                </button>
            </div>
        </div>
    </div>
}

<style>
    .confirmation-overlay {
        position: fixed;
        inset: 0;
        z-index: 1060;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(23, 35, 58, 0.48);
    }

    .confirmation-dialog {
        width: min(100%, 440px);
        overflow: hidden;
        background: #fff;
        border: 0;
        border-radius: 1rem;
        box-shadow: 0 1rem 3rem rgba(23, 35, 58, 0.2);
        animation: confirmationFadeIn 0.2s ease-out;
    }

    .confirmation-header {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 1.25rem 1.5rem;
        background: #f5f7ff;
        border-bottom: 1px solid #e8ecf7;
    }

    .confirmation-icon {
        display: grid;
        width: 2.5rem;
        height: 2.5rem;
        flex: 0 0 2.5rem;
        place-items: center;
        color: #4a63f3;
        background: #e4e9ff;
        border-radius: 50%;
        font-size: 1.25rem;
    }

    .confirmation-header h5 {
        color: #24345d;
        font-weight: 700;
    }

    .confirmation-body {
        padding: 1.5rem;
        color: #343d52;
    }

    .confirmation-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        padding: 0 1.5rem 1.5rem;
    }

    .confirmation-footer .btn-light {
        color: #495057;
        background: #f1f3f5;
        border-color: #e2e6ea;
    }

    @@keyframes confirmationFadeIn {
        from {
            opacity: 0;
            transform: translateY(-0.5rem) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
</style>

@code {
    private List<ParsedOrder>? orders;
    private ParsedOrder? selectedOrder;
    private bool showSaveConfirmation;

    private bool isLoading = true;

    private bool _sortDescending = true;
    private bool sortDescending
    {
        get => _sortDescending;
        set
        {
            if (_sortDescending != value)
            {
                _sortDescending = value;
                _ = LoadOrders(); // Fire and forget
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await LoadOrders();
        isLoading = false;
    }

    private async Task LoadOrders()
    {
        var allOrders = await Db.Orders
            .Include(o => o.Items)
            .ToListAsync();

        var today = DateOnly.FromDateTime(DateTime.Today);
        orders = sortDescending
            ? allOrders.OrderByDescending(order => GetDistanceFromToday(order, today)).ToList()
            : allOrders.OrderBy(order => GetDistanceFromToday(order, today)).ToList();
    }

    private static int GetDistanceFromToday(ParsedOrder order, DateOnly today)
    {
        var orderDate = GetOrderDate(order);
        return orderDate is DateOnly date
            ? Math.Abs(date.DayNumber - today.DayNumber)
            : int.MaxValue;
    }

    private static DateOnly? GetOrderDate(ParsedOrder order)
    {
        if (order.ParsedDate is DateOnly parsedDate)
            return parsedDate;

        string[] formats =
        [
            "d MMMM yyyy", "dd MMMM yyyy", "d MMM yyyy", "dd MMM yyyy",
            "d/M/yyyy", "dd/MM/yyyy", "d/M/yy", "dd/MM/yy", "yyyy-MM-dd",
            "M/d/yyyy", "MM/dd/yyyy"
        ];

        return DateOnly.TryParseExact(
            order.Date,
            formats,
            CultureInfo.InvariantCulture,
            DateTimeStyles.AllowWhiteSpaces,
            out var legacyDate)
            ? legacyDate
            : null;
    }

    private void OpenModal(ParsedOrder order)
    {
        // Create deep copy to avoid modifying original until saved
        selectedOrder = new ParsedOrder
        {
            Id = order.Id,
            Name = order.Name,
            Phone = order.Phone,
            Date = order.Date,
            ParsedDate = order.ParsedDate,
            Address = order.Address,
            Items = order.Items.Select(i => new OrderItem
            {
                Id = i.Id,
                ProductName = i.ProductName,
                Quantity = i.Quantity
            }).ToList()
        };
    }

    private void CloseModal()
    {
        selectedOrder = null;
    }

    private void SaveChanges()
    {
        if (selectedOrder is not null)
            showSaveConfirmation = true;
    }

    private void CancelSaveChanges()
    {
        showSaveConfirmation = false;
    }

    private async Task ConfirmSaveChanges()
    {
        if (selectedOrder is null)
        {
            showSaveConfirmation = false;
            return;
        }

        var existing = await Db.Orders.Include(o => o.Items)
                                      .FirstOrDefaultAsync(o => o.Id == selectedOrder.Id);

        if (existing is not null)
        {
            existing.Name = selectedOrder.Name;
            existing.Phone = selectedOrder.Phone;
            existing.Date = selectedOrder.Date;
            existing.ParsedDate = selectedOrder.ParsedDate;
            existing.Address = selectedOrder.Address;

            // Replace all items
            Db.OrderItems.RemoveRange(existing.Items);
            existing.Items = selectedOrder.Items;

            await Db.SaveChangesAsync();
            await LoadOrders();
        }

        showSaveConfirmation = false;
        CloseModal();
    }

    private void OnQuantityInput(ChangeEventArgs e, OrderItem Item)
    {
        if(int.TryParse(e.Value?.ToString(), out var quantity))
        {
            Item.Quantity = quantity;
        }
        else
        {
            Item.Quantity = 0;
        }
    }

    [Inject] IJSRuntime JSRuntime { get; set; } = default!;

    private async Task DeleteOrder()
    {
        if (selectedOrder is null)
            return;

        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this order?"))
            return;

        var existing = await Db.Orders.Include(o => o.Items)
                                      .FirstOrDefaultAsync(o => o.Id == selectedOrder.Id);

        if (existing is not null)
        {
            Db.OrderItems.RemoveRange(existing.Items);
            Db.Orders.Remove(existing);
            await Db.SaveChangesAsync();
            await LoadOrders();
        }

        CloseModal();
    }

    private string BindDate
    {
        get
        {
            if (selectedOrder?.ParsedDate is DateOnly date)
                return date.ToString("yyyy-MM-dd");
            return string.Empty;
        }
        set
        {
            if (selectedOrder != null && DateOnly.TryParse(value, out var date))
                selectedOrder.ParsedDate = date;
        }
    }

    private void OnDateChanged(ChangeEventArgs e)
    {
        BindDate = e.Value?.ToString() ?? "";
    }
}