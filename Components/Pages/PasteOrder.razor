@page "/pasteorder"
@rendermode InteractiveServer

@using Bestella.Models
@using Bestella.Data
@using Bestella.Services

@inject OrderDbContext Db
@inject OrderParser Parser

<h3 class="mb-3">Paste WhatsApp Order</h3>

<div class="mb-3">
    <textarea class="form-control fixed-height-textarea"
          placeholder="Paste your WhatsApp order here..."
          @bind="orderText"
          @ref="textAreaRef"
          rows="10"
          style="overflow:auto; resize:none;">
    </textarea>
</div>

<button class="btn btn-primary mb-4" @onclick="ParseOrder" disabled="@isLoading">Parse</button>

@if (isLoading)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@if (parseErrors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <strong>Check the order before saving:</strong>
        <ul class="mb-0">
            @foreach (var error in parseErrors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@if (parsedOrder is not null)
{
    <div class="card shadow-sm">
        <div class="card-body">
            <h5>Order preview</h5>
            <p><strong>Name:</strong> @parsedOrder.Name</p>
            <p><strong>Address:</strong> @parsedOrder.Address</p>
            <p><strong>Date:</strong> @(parsedOrder.ParsedDate?.ToString("dd MMMM yyyy") ?? "Invalid")</p>
            <p><strong>Phone:</strong> @parsedOrder.Phone</p>

            <ul class="list-group list-group-flush">
                @foreach (var item in parsedOrder.Items)
                {
                    <li class="list-group-item">@item.Quantity x @item.ProductName</li>
                }
            </ul>

            @if (parseErrors.Count == 0 && !hasSaved)
            {
                <button class="btn btn-success mt-3" @onclick="SaveOrder" disabled="@isLoading">Confirm and save order</button>
            }
            else if (hasSaved)
            {
                <p class="text-success mt-3 mb-0"><strong>Order saved. ID:</strong> @parsedOrder.Id</p>
            }
        </div>
    </div>
}

@if (showToast)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1000;">
        <div class="toast align-items-center text-white bg-success border-0 show fade"
             role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    Order saved successfully!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        @onclick="() => showToast = false"></button>
            </div>
        </div>
    </div>
}

<style>
    .auto-resize {
        min-height: 100px;
        font-family: inherit;
        font-size: 1rem;
        line-height: 1.5;
        padding: 0.75rem;
    }

    .fixed-height-textarea {
        height: 30vh; /* 50% of the viewport height */
        font-family: inherit;
        font-size: 1rem;
        line-height: 1.5;
        padding: 0.75rem;
    }
</style>

@code {

    private bool showToast = false;
    private string orderText = string.Empty;
    private ParsedOrder? parsedOrder;
    private List<string> parseErrors = [];
    private bool hasSaved;
    private bool isLoading = false;
    private ElementReference textAreaRef;
    private Task ParseOrder()
    {
        parseErrors.Clear();
        hasSaved = false;

        if (string.IsNullOrWhiteSpace(orderText))
        {
            parseErrors.Add("Paste an order before parsing.");
            parsedOrder = null;
            return Task.CompletedTask;
        }

        var result = Parser.Parse(orderText);
        parsedOrder = result.Order;
        parseErrors = result.Errors.ToList();
        return Task.CompletedTask;
    }

    private async Task SaveOrder()
    {
        if (parsedOrder is null || parseErrors.Count > 0 || hasSaved)
            return;

        isLoading = true;
        parsedOrder.Id = 1000000000000000 + long.Parse(DateTime.UtcNow.ToString("yyMMddHHmmssfff"));
        parsedOrder.Date = parsedOrder.ParsedDate!.Value.ToString("dd MMMM yyyy");
        Db.Orders.Add(parsedOrder);
        await Db.SaveChangesAsync();
        isLoading = false;

        hasSaved = true;
        orderText = string.Empty;
        showToast = true;
        _ = HideToast();
    }

    private async Task HideToast()
    {
        await Task.Delay(3000);
        showToast = false;
        await InvokeAsync(StateHasChanged);
    }
}